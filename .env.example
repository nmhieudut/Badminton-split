# ─── Database ────────────────────────────────────────────────────────────────
#
# Khi chạy ở máy, kết nối trực tiếp (cổng 5432) dùng được:
#   postgresql://postgres:<mật_khẩu>@db.<project-ref>.supabase.co:5432/postgres
#
# Khi triển khai lên Vercel, BẮT BUỘC dùng transaction pooler (cổng 6543).
# Host kết nối trực tiếp chỉ có bản ghi DNS IPv6, mà Vercel serverless chỉ đi
# IPv4 nên sẽ không kết nối được. Pooler cũng đòi tên đăng nhập có project-ref:
#   postgresql://postgres.<project-ref>:<mật_khẩu>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Storage (ảnh QR) ────────────────────────────────────────────────────────
#
# Chỉ dùng phía server. service_role có TOÀN QUYỀN trên database — không bao
# giờ đặt nó vào biến có tiền tố NEXT_PUBLIC_, vì như vậy là đẩy xuống trình
# duyệt cho mọi người đọc.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Đăng nhập ───────────────────────────────────────────────────────────────
#
# Hai biến này đi xuống trình duyệt theo đúng thiết kế. anon key là khóa công
# khai, không phải bí mật — nhưng phải là anon, KHÔNG PHẢI service_role.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ai được phép ghi dữ liệu. Danh sách email ngăn cách bằng DẤU PHẨY.
# Khoảng trắng quanh dấu phẩy và chữ hoa chữ thường đều được bỏ qua.
#   ADMIN_EMAILS=chunhom@gmail.com,phupho@gmail.com
#
# Để trống thì KHÔNG AI ghi được gì — app thành chỉ đọc hoàn toàn.
ADMIN_EMAILS=
